{% extends 'base.html.twig' %}

{% block title %}Edycja pojazdu{% endblock %}

{% block body %}
    <main class="card bg-body-tertiary shadow-sm">
        <div class="card-body p-4 p-md-5">
            <h1 class="h3">Edytuj pojazd</h1>
            {{ form_start(editForm) }}
                {{ form_row(editForm.licensePlate) }}
                {{ form_row(editForm.save) }}
            {{ form_end(editForm) }}
            <p class="mt-4 mb-0"><a href="{{ path('app_vehicle_index') }}">← Powrót do pojazdów</a></p>
        </div>
    </main>
{% endblock %}
